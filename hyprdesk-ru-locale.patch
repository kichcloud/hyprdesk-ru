@@ -172,9 +200,9 @@ pub fn tr(s: &str) -> &str {
 
 /// Texte dans une langue donnée.
 pub fn tr_in(lang: Lang, s: &str) -> &str {
-    match lang {
-        Lang::Fr => s,
-        Lang::En => catalog().get(s).map(String::as_str).unwrap_or(s),
+    match catalog_for(lang) {
